<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Surface known-vulnerable dependencies (incl. transitive) as build warnings. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Product>SharpVision</Product>

    <!-- Base Lumina (sqpack reader) package version. Single source of truth: used by
         the PackageReference below and shown in the startup banner (GenerateBuildInfo). -->
    <LuminaVersion>7.7.1</LuminaVersion>

    <!-- Which EXDSchema the generated sheet types are built from. "EXDSchema-experimental"
         tracks the latest client; switch to "EXDSchema" (stable) if it ever breaks the build.
         Single source of truth: drives the Lumina.Excel SchemaPath below and the schema
         name/version shown in the startup banner (GenerateBuildInfo). -->
    <ExdSchema>EXDSchema-experimental</ExdSchema>
    <ExdSchemaDir>$(MSBuildProjectDirectory)\external\Lumina.Excel\deps\$(ExdSchema)</ExdSchemaDir>
    <ExdSchemaLabel>EXDSchema (stable)</ExdSchemaLabel>
    <ExdSchemaLabel Condition="$(ExdSchema.Contains('experimental'))">EXDSchema (experimental)</ExdSchemaLabel>

    <!-- Version 1.0.0.N, N incremented by 1 each build. N is read here at
         evaluation (so the SDK bakes it into the assembly) from the gitignored
         "build.number" file, and written back by the GenerateBuildInfo target.
         AssemblyVersion stays fixed; only File/Informational version carry N. -->
    <_CounterFile>$(MSBuildProjectDirectory)\build.number</_CounterFile>
    <_PrevBuildRaw>0</_PrevBuildRaw>
    <_PrevBuildRaw Condition="Exists('$(_CounterFile)')">$([System.IO.File]::ReadAllText('$(_CounterFile)'))</_PrevBuildRaw>
    <_PrevBuild>$(_PrevBuildRaw.Trim())</_PrevBuild>
    <_PrevBuild Condition="'$(_PrevBuild)' == ''">0</_PrevBuild>
    <BuildNumber>$([MSBuild]::Add($(_PrevBuild), 1))</BuildNumber>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.$(BuildNumber)</FileVersion>
    <InformationalVersion>1.0.0.$(BuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="external/**/*.cs" />
    <PackageReference Include="Lumina" Version="$(LuminaVersion)" />
    <!-- Stay on ImageSharp 3.1.x: 4.x has the same Split License (free for open source)
         but validates a Six Labors license key at build time, and Release builds fail
         without one — a burden on everyone building this repo from source. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Managed (cross-platform) decoder for CRI HCA, used for the few BGM .scd
         that store HCA instead of Ogg Vorbis. -->
    <PackageReference Include="VGAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- ImageSharp 3.1.12 advisories fixed only in 4.1.2+ (see above for why we stay on
       3.1). None is reachable here: we only build images from raw pixels
       (Image.LoadPixelData) and encode PNG/JPEG — no TIFF encode/decode, no ICC profile
       parsing, no HistogramEqualization. Suppressed one by one so any NEW advisory
       still surfaces as a build warning. Re-check if image handling changes. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" /> <!-- HistogramEqualization -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" /> <!-- TIFF CCITT T4 encoder -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" /> <!-- TIFF CCITT T6 encoder -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" /> <!-- ICC CLUT parsing -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" /> <!-- BigTIFF IFD decode loop -->
  </ItemGroup>

  <!-- Lumina.Excel is built from source (not NuGet) so the generated sheet types
       can be regenerated from the latest EXDSchema, matching the current client.
       SchemaPath is overridden here (as a global property, without editing the
       Lumina.Excel sources) to point the main Lumina.Excel.Sheets namespace at the
       schema selected by the ExdSchema property above. -->
  <ItemGroup>
    <ProjectReference Include="external/Lumina.Excel/src/Lumina.Excel/Lumina.Excel.csproj">
      <AdditionalProperties>SchemaPath=$(ExdSchemaDir)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Generated by GenerateBuildInfo below; declared here (at evaluation) so the
       compiler and IDE/IntelliSense pick it up once it has been generated once. -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
  </ItemGroup>

  <!-- On each real build: capture the referenced submodule versions via git, write
       a generated BuildInfo source the startup banner reads, and persist the
       incremented build number. Skipped for design-time/IntelliSense builds.
       Tolerant of git/submodule being unavailable (values fall back to "unknown"). -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true'">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)\external\Lumina.Excel&quot; rev-parse --short HEAD"
          Condition="Exists('$(MSBuildProjectDirectory)\external\Lumina.Excel\.git')"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LuminaExcelVer" />
    </Exec>
    <Exec Command="git -C &quot;$(ExdSchemaDir)&quot; log -1 --format=%25%25cI"
          Condition="Exists('$(ExdSchemaDir)\.git')"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ExdSchemaVer" />
    </Exec>
    <PropertyGroup>
      <_LuminaExcelVer Condition="'$(_LuminaExcelVer)' == ''">unknown</_LuminaExcelVer>
      <_ExdSchemaVer Condition="'$(_ExdSchemaVer)' == ''">unknown</_ExdSchemaVer>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLine Include="namespace SharpVision%3B" />
      <_BuildInfoLine Include="internal static class BuildInfo" />
      <_BuildInfoLine Include="{" />
      <_BuildInfoLine Include="    public const string Version = &quot;1.0.0.$(BuildNumber)&quot;%3B" />
      <_BuildInfoLine Include="    public const string Lumina = &quot;$(LuminaVersion)&quot;%3B" />
      <_BuildInfoLine Include="    public const string LuminaExcel = &quot;$(_LuminaExcelVer.Trim())&quot;%3B" />
      <_BuildInfoLine Include="    public const string ExdSchemaName = &quot;$(ExdSchemaLabel)&quot;%3B" />
      <_BuildInfoLine Include="    public const string ExdSchemaVersion = &quot;$(_ExdSchemaVer.Trim())&quot;%3B" />
      <_BuildInfoLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_BuildInfoFile)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CounterFile)" Lines="$(BuildNumber)" Overwrite="true" />
  </Target>

</Project>
